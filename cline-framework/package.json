{
  "name": "@cline/framework",
  "version": "0.1.0",
  "description": "Reusable agent framework extracted from Cline - execute AI agents in VSCode or terminal",
  "main": "./core/index.js",
  "types": "./core/index.d.ts",
  "exports": {
    ".": "./core/index.js",
    "./core": "./core/index.js",
    "./host": "./host/index.js",
    "./services": "./services/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "clean": "rm -rf dist core/*.js host/*.js services/*.js cli/*.js",
    "demo": "node demo/simple-agent.js"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "automation",
    "cli",
    "framework"
  ],
  "author": "Cline Framework Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "openai": "^4.83.0",
    "axios": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
